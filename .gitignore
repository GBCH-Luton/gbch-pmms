# Secrets -- Supabase URL/keys, including the service-role key that
# bypasses Row-Level Security entirely. Must never be committed.
.env
.env.local
.env.*.local

node_modules
client/dist

# Claude Code's own local tool state, not project source
.claude/

# Supabase CLI's local link state -- regenerated by `supabase link`, not
# project source (also avoids tracking connection endpoint details).
supabase/.temp/

# Database data snapshots -- a different kind of backup than code (no
# meaningful diffs, would bloat the repo over time). Kept as a standalone
# folder on disk instead, separate from version control.
backups/

# Editor/OS cruft
.DS_Store
